{
  "name": "brickwise-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Brickwise de escritorio: Electron + Node embebido ejecutando el servidor standalone de Next.js",
  "productName": "Brickwise",
  "author": "eljommys",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "icon": "electron scripts/make-icon.cjs",
    "logo": "electron scripts/make-logo.cjs",
    "prepare-server": "node scripts/prepare-server.mjs",
    "start": "electron .",
    "pack:dir": "electron-builder --mac --arm64 --dir --publish never",
    "dist:mac": "npm run prepare-server && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run prepare-server && electron-builder --win --x64 --publish never",
    "dist": "npm run prepare-server && electron-builder --mac --arm64 --publish never && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  }
}
